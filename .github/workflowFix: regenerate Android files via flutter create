name: Flutter Build Verification

on:
  push:
    branches: [ main ]
  workflow_dispatch: {}

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: 1. Checkout repository
        uses: actions/checkout@v4

      - name: 2. List files (debug)
        run: ls -la

      - name: 3. Extract all ZIP files
        run: |
          mkdir -p extracted
          for f in *.zip; do
            if [ -f "$f" ]; then
              echo "=== Extracting: $f ==="
              unzip -o "$f" -d extracted/ || true
            fi
          done
          echo "=== After extraction ==="
          ls -la extracted/

      - name: 4. Locate the Flutter project
        id: locate
        run: |
          set -e
          PUBSPEC_PATH=$(find . -maxdepth 6 -iname "pubspec.yaml" -not -path "*/build/*" | head -n 1)
          if [ -z "$PUBSPEC_PATH" ]; then
            echo "::error::لم يُعثر على pubspec.yaml."
            find . -type f -name "*.zip"
            exit 1
          fi
          PROJECT_DIR=$(dirname "$PUBSPEC_PATH")
          echo "project_dir=$PROJECT_DIR" >> "$GITHUB_OUTPUT"
          echo "✅ وُجد المشروع في: $PROJECT_DIR"

      - name: 5. Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: 6. Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
          cache: true

      - name: 7. Flutter version
        run: flutter --version

      - name: 8. flutter pub get
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: flutter pub get

      - name: 9. build_runner
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: dart run build_runner build --delete-conflicting-outputs
        continue-on-error: true

      - name: 10. Verify Hive files
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          ls -la lib/models/ || true
          echo "=== Files that end with .g.dart ==="
          find lib -name "*.g.dart" -type f || true

      - name: 11. flutter analyze
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: flutter analyze --no-fatal-infos
        continue-on-error: true

      - name: 12. flutter test
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: flutter test
        continue-on-error: true

      - name: 13. Backup android/app/src
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          set -e
          ls -la android/app/src/ || true
          ls -la android/app/src/main/ || true
          cp -r android/app/src android_app_src_backup
          echo "=== Backup complete ==="
          ls -la android_app_src_backup/

      - name: 14. Delete broken android folder
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          set -e
          echo "=== Deleting broken android/ folder ==="
          rm -rf android
          echo "=== Android deleted — will be regenerated by real Flutter ==="

      - name: 15. Regenerate android via flutter create
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          set -e
          PROJECT_NAME=$(grep -m1 '^name:' pubspec.yaml | sed 's/name://;s/ //g')
          echo "Project name: $PROJECT_NAME"
          flutter create --platforms=android --overwrite --org com.buddysystem --project-name "$PROJECT_NAME" .
          echo "=== New android/ structure ==="
          ls -la android/
          ls -la android/app/

      - name: 16. Restore custom android/app/src
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          set -e
          if [ -d "android_app_src_backup" ]; then
            echo "=== Restoring custom src files ==="
            rm -rf android/app/src
            cp -r android_app_src_backup android/app/src
            echo "=== Restored ==="
            ls -la android/app/src/
            ls -la android/app/src/main/
          else
            echo "No backup found — skipping restore"
          fi

      - name: 17. Fix namespace, applicationId, minSdk
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          set -e
          FILE=android/app/build.gradle
          if [ -f "$FILE" ]; then
            sed -i 's/namespace ".*"/namespace "com.buddysystem.buddy_system"/' "$FILE" || true
            sed -i 's/applicationId ".*"/applicationId "com.buddysystem.buddy_system"/' "$FILE" || true
            sed -i 's/minSdkVersion .*/minSdkVersion 23/' "$FILE" || true
            sed -i 's/minSdk .*/minSdk 23/' "$FILE" || true
            echo "=== After sed ==="
            grep -E "namespace|applicationId|minSdk" "$FILE" || true
          fi
          PROPS=android/gradle.properties
          if [ -f "$PROPS" ]; then
            grep -q "android.useAndroidX" "$PROPS" || echo "android.useAndroidX=true" >> "$PROPS"
            grep -q "android.enableJetifier" "$PROPS" || echo "android.enableJetifier=true" >> "$PROPS"
            echo "=== gradle.properties ==="
            cat "$PROPS"
          fi

      - name: 18. Rewrite MainActivity.kt
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          set -e
          MA_FILE=$(find android -name "MainActivity.kt" -type f | head -1)
          if [ -n "$MA_FILE" ]; then
            echo "Found MainActivity at: $MA_FILE"
            rm "$MA_FILE"
            cat > "$MA_FILE" << 'EOF'
          package com.buddysystem.buddy_system

          import io.flutter.embedding.android.FlutterActivity

          class MainActivity : FlutterActivity()
          EOF
            sed -i 's/^          //' "$MA_FILE" || true
            echo "=== New MainActivity.kt ==="
            cat "$MA_FILE"
          else
            echo "MainActivity.kt not found"
          fi

      - name: 19. flutter build apk --debug
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: flutter build apk --debug

      - name: 20. Verify APK exists
        working-directory: ${{ steps.locate.outputs.project_dir }}
        run: |
          set -e
          APK_PATH="build/app/outputs/flutter-apk/app-debug.apk"
          test -f "$APK_PATH"
          echo "✓ APK موجود: $APK_PATH"
          ls -la "$APK_PATH"

      - name: 21. Upload APK
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: buddy-system-debug-apk
          path: ${{ steps.locate.outputs.project_dir }}/build/app/outputs/flutter-apk/app-debug.apk
          retention-days: 30
